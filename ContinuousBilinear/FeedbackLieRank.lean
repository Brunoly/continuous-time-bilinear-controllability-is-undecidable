import ContinuousBilinear.FeedbackShearMatrixProof
import ContinuousBilinear.InvariantSubspaceExponential
import ContinuousBilinear.PlantLieRank
import Mathlib.Data.Matrix.Basis

namespace ContinuousBilinear.FeedbackData

open Set

attribute [local instance] LieRing.ofAssociativeRing

variable {d m : ℕ}

private abbrev block (M : RealMatrix d) : RealMatrix (d + 1) := scalarBlock d (0, M)

@[simp] private theorem cases_zero_vector :
    (fun i : Fin (d + 1) => Fin.cases (motive := fun _ : Fin (d + 1) => ℝ) 0 (0 : State d) i) = 0 := by
  funext i
  cases i using Fin.cases <;> rfl

@[simp] private theorem zero_ne_succ (i : Fin d) : (0 : Fin (d + 1)) ≠ i.succ :=
  Ne.symm (Fin.succ_ne_zero i)

private theorem block_mulVec (M : RealMatrix d) (s : ℝ) (x : State d) :
    (block M).mulVec (Fin.cases s x) = Fin.cases 0 (M.mulVec x) := by
  rw [scalarBlock_mulVec]
  simp

private theorem vecMul_block (M : RealMatrix d) (s : ℝ) (x : State d) :
    Matrix.vecMul (Fin.cases s x) (block M) = Fin.cases 0 (M.transpose.mulVec x) := by
  funext j
  refine Fin.cases ?_ (fun k => ?_) j
  · simp [Matrix.vecMul, dotProduct, Fin.sum_univ_succ, block, scalarBlock, RingHom.coe_mk]
  · simp [Matrix.vecMul, Matrix.mulVec, dotProduct, Fin.sum_univ_succ, block, scalarBlock,
      RingHom.coe_mk, mul_comm]

private theorem shearToState_add (x y : State d) :
    shearToState (x + y) = shearToState x + shearToState y := by
  ext i j
  refine Fin.cases ?_ (fun a => ?_) i
  all_goals simp [shearToState, Matrix.vecMulVec_apply, add_mul]

private theorem shearToScalar_add (x y : State d) :
    shearToScalar (x + y) = shearToScalar x + shearToScalar y := by
  ext i j
  refine Fin.cases ?_ (fun a => ?_) j
  all_goals simp [shearToScalar, Matrix.vecMulVec_apply, mul_add]

private theorem shearToState_smul (r : ℝ) (x : State d) :
    shearToState (r • x) = r • shearToState x := by
  ext i j
  refine Fin.cases ?_ (fun a => ?_) i
  all_goals simp [shearToState, Matrix.vecMulVec_apply, mul_assoc]

private theorem shearToScalar_smul (r : ℝ) (x : State d) :
    shearToScalar (r • x) = r • shearToScalar x := by
  ext i j
  refine Fin.cases ?_ (fun a => ?_) j
  all_goals simp [shearToScalar, Matrix.vecMulVec_apply, mul_left_comm]

private def shearToStateLinear : State d →ₗ[ℝ] RealMatrix (d + 1) where
  toFun := shearToState
  map_add' := shearToState_add
  map_smul' := shearToState_smul

private def shearToScalarLinear : State d →ₗ[ℝ] RealMatrix (d + 1) where
  toFun := shearToScalar
  map_add' := shearToScalar_add
  map_smul' := shearToScalar_smul

private theorem bracket_block_shearToState (M : RealMatrix d) (w : State d) :
    ⁅block M, shearToState w⁆ = shearToState (M.mulVec w) := by
  change block M * shearToState w - shearToState w * block M = _
  simp [shearToState, Matrix.mul_vecMulVec, Matrix.vecMulVec_mul, block_mulVec, vecMul_block]
  exact Or.inr rfl

private theorem bracket_block_shearToScalar (M : RealMatrix d) (w : State d) :
    ⁅block M, shearToScalar w⁆ = -shearToScalar (M.transpose.mulVec w) := by
  change block M * shearToScalar w - shearToScalar w * block M = _
  simp [shearToScalar, Matrix.mul_vecMulVec, Matrix.vecMulVec_mul, block_mulVec, vecMul_block]
  exact Or.inl rfl

private theorem drift_decomposition (F : FeedbackData d m) :
    (F.plant.drift : RealMatrix (d + 1)) = (1 / 2 : ℝ) •
      (scalarBlock d (1, Matrix.vecMulVec F.b F.ell) +
        shearToState F.b + shearToScalar F.ell) := by
  ext i j
  refine Fin.cases ?_ (fun a => ?_) i <;> refine Fin.cases ?_ (fun b => ?_) j
  all_goals simp [plant, scalarBlock, RingHom.coe_mk, shearToState, shearToScalar,
    Matrix.vecMulVec_apply, mul_assoc]

private theorem bracket_block_one_diagonal (c : ℝ) (M : RealMatrix d) :
    ⁅block (1 : RealMatrix d), scalarBlock d (c, M)⁆ = 0 := by
  change block (1 : RealMatrix d) * scalarBlock d (c, M) -
    scalarBlock d (c, M) * block (1 : RealMatrix d) = 0
  rw [← map_mul, ← map_mul]
  simp

private theorem bracket_shearToState_shearToScalar (x y : State d) :
    ⁅shearToState x, shearToScalar y⁆ =
      block (Matrix.vecMulVec x y) - (dotProduct y x : ℝ) • scalarBlock d (1, 0) := by
  change shearToState x * shearToScalar y - shearToScalar y * shearToState x = _
  simp only [shearToState, shearToScalar, Matrix.vecMulVec_mul_vecMulVec]
  ext i j
  refine Fin.cases ?_ (fun a => ?_) i <;> refine Fin.cases ?_ (fun b => ?_) j
  all_goals simp [block, scalarBlock, RingHom.coe_mk, dotProduct, Fin.sum_univ_succ,
    Matrix.vecMulVec_apply]

/-- The Lie algebra generated by the feedback plant's available generators is full. -/
theorem lieSpan_generator_eq_top (F : FeedbackData d m) (hF : F.Hypotheses) :
    LieSubalgebra.lieSpan ℝ (RealMatrix (d + 1)) (Set.range (generator F.plant)) = ⊤ := by
  let L := LieSubalgebra.lieSpan ℝ (RealMatrix (d + 1)) (Set.range (generator F.plant))
  let W := L.toSubmodule
  let drift : RealMatrix (d + 1) := F.plant.drift
  have hdrift : drift ∈ L := LieSubalgebra.subset_lieSpan
    ⟨0, by simp [drift, generator]; rfl⟩
  have hcontrol (u : Fin (m + 1) → ℝ) : F.controlGenerator u ∈ L := by
    have hGen : (generator F.plant u : RealMatrix (d + 1)) ∈ L :=
      LieSubalgebra.subset_lieSpan ⟨u, rfl⟩
    have h := L.sub_mem hGen hdrift
    let M : RealMatrix (d + 1) := generator F.plant u
    have heq : M - drift = F.controlGenerator u := by
      rw [show M = _ from F.generator_eq_drift_add_controlGenerator u]
      change drift + F.controlGenerator u - drift = _
      abel
    exact heq ▸ h
  have hD : block (1 : RealMatrix d) ∈ L := by
    have h := hcontrol (Fin.cases 1 0)
    change scalarBlock d (0, (1 : ℝ) • 1 + ∑ i : Fin m, (0 : ℝ) • F.K i) ∈ L at h
    simpa using h
  have hK (t : Fin m → ℝ) : block (∑ i, t i • F.K i) ∈ L := by
    have h := hcontrol (Fin.cases 0 t)
    change scalarBlock d (0, (0 : ℝ) • 1 + ∑ i : Fin m, t i • F.K i) ∈ L at h
    simpa using h
  let U := shearToState F.b
  let V := shearToScalar F.ell
  let D := block (1 : RealMatrix d)
  have h₁ : ⁅D, drift⁆ = (1 / 2 : ℝ) • (U - V) := by
    rw [show drift = _ from drift_decomposition F, lie_smul, lie_add, lie_add]
    simp [D, U, V, bracket_block_one_diagonal, bracket_block_shearToState,
      bracket_block_shearToScalar, sub_eq_add_neg]
  have h₂ : ⁅D, ⁅D, drift⁆⁆ = (1 / 2 : ℝ) • (U + V) := by
    rw [h₁, lie_smul, lie_sub]
    simp [D, U, V, bracket_block_shearToState, bracket_block_shearToScalar]
  have hUV : U - V ∈ W := by
    have h : (1 / 2 : ℝ) • (U - V) ∈ W := h₁ ▸ L.lie_mem hD hdrift
    simpa [smul_smul] using W.smul_mem (2 : ℝ) h
  have hVU : U + V ∈ W := by
    have h : (1 / 2 : ℝ) • (U + V) ∈ W := h₂ ▸ L.lie_mem hD (L.lie_mem hD hdrift)
    simpa [smul_smul] using W.smul_mem (2 : ℝ) h
  have hU : U ∈ W := by
    convert W.smul_mem (1 / 2 : ℝ) (W.add_mem hUV hVU) using 1
    module
  have hV : V ∈ W := by
    convert W.smul_mem (1 / 2 : ℝ) (W.sub_mem hVU hUV) using 1
    module
  let Wcol := W.comap shearToStateLinear
  let Wrow := W.comap shearToScalarLinear
  have hcol (x : State d) : shearToState x ∈ W := by
    have hle : Submodule.span ℝ (Set.range fun t => (F.orbitMatrix t).mulVec F.b) ≤ Wcol := by
      apply Submodule.span_le.mpr
      rintro _ ⟨t, rfl⟩
      let M : RealMatrix d := ∑ i, t i • F.K i
      apply exp_mulVec_mem_of_mulVec_mem M Wcol _ hU
      intro x hx
      change shearToState (M.mulVec x) ∈ L
      rw [← bracket_block_shearToState]
      exact L.lie_mem (hK t) hx
    have h := hF.2.2.1
    rw [h] at hle
    exact hle (show x ∈ (⊤ : Submodule ℝ (State d)) from trivial)
  have hrow (y : State d) : shearToScalar y ∈ W := by
    have hle : Submodule.span ℝ (Set.range fun t => fun j =>
        ∑ i, F.ell i * F.orbitMatrix t i j) ≤ Wrow := by
      apply Submodule.span_le.mpr
      rintro _ ⟨t, rfl⟩
      let M : RealMatrix d := ∑ i, t i • F.K i
      have hrowEq : (fun j => ∑ i, F.ell i * F.orbitMatrix t i j) =
          (NormedSpace.exp M.transpose).mulVec F.ell := by
        rw [Matrix.exp_transpose]
        ext j
        simp [Matrix.mulVec, dotProduct, FeedbackData.orbitMatrix, M, mul_comm]
      change (fun j => ∑ i, F.ell i * F.orbitMatrix t i j) ∈ Wrow
      rw [hrowEq]
      apply exp_mulVec_mem_of_mulVec_mem M.transpose Wrow _ hV
      intro y hy
      change shearToScalar (M.transpose.mulVec y) ∈ L
      have h := L.lie_mem (hK t) (show shearToScalar y ∈ L from hy)
      rw [bracket_block_shearToScalar] at h
      simpa using L.neg_mem h
    have h := hF.2.2.2
    rw [h] at hle
    exact hle (show y ∈ (⊤ : Submodule ℝ (State d)) from trivial)
  let E := scalarBlock d (1, 0)
  have hdiag : scalarBlock d (1, Matrix.vecMulVec F.b F.ell) ∈ W := by
    have h : (2 : ℝ) • drift - U - V ∈ W :=
      W.sub_mem (W.sub_mem (W.smul_mem 2 hdrift) hU) hV
    have heq : (2 : ℝ) • drift - U - V = scalarBlock d (1, Matrix.vecMulVec F.b F.ell) := by
      rw [show drift = _ from drift_decomposition F, smul_smul]
      norm_num
      change scalarBlock d (1, Matrix.vecMulVec F.b F.ell) + U + V - U - V = _
      abel
    exact heq ▸ h
  have hbr : block (Matrix.vecMulVec F.b F.ell) - E ∈ W := by
    have h := L.lie_mem (show U ∈ L from hU) (show V ∈ L from hV)
    have hPair : dotProduct F.ell F.b = 1 := hF.2.1
    change ⁅U, V⁆ ∈ W at h
    simpa [U, V, E, bracket_shearToState_shearToScalar, hPair] using h
  have hE : E ∈ W := by
    have hBlock : scalarBlock d (1, Matrix.vecMulVec F.b F.ell) =
        E + block (Matrix.vecMulVec F.b F.ell) := by
      rw [← map_add]
      simp
    rw [hBlock] at hdiag
    convert W.smul_mem (1 / 2 : ℝ) (W.sub_mem hdiag hbr) using 1
    module
  have hBlock (x y : State d) : block (Matrix.vecMulVec x y) ∈ W := by
    have hb := L.lie_mem (show shearToState x ∈ L from hcol x)
      (show shearToScalar y ∈ L from hrow y)
    rw [bracket_shearToState_shearToScalar] at hb
    simpa [E] using W.add_mem hb (W.smul_mem (dotProduct y x) hE)
  have hSingle (i j : Fin (d + 1)) : Matrix.single i j (1 : ℝ) ∈ W := by
    classical
    refine Fin.cases ?_ (fun a => ?_) i <;> refine Fin.cases ?_ (fun b => ?_) j
    · convert hE using 1
      ext i j
      refine Fin.cases ?_ (fun a => ?_) i <;> refine Fin.cases ?_ (fun b => ?_) j
      all_goals simp [E, scalarBlock, RingHom.coe_mk, Matrix.zero_apply]
    · convert hrow (Pi.single b 1) using 1
      ext i j
      refine Fin.cases ?_ (fun a => ?_) i <;> refine Fin.cases ?_ (fun b => ?_) j
      all_goals simp [shearToScalar, Matrix.vecMulVec_apply, Pi.single_apply, Matrix.single_apply, eq_comm]
    · convert hcol (Pi.single a 1) using 1
      ext i j
      refine Fin.cases ?_ (fun a => ?_) i <;> refine Fin.cases ?_ (fun b => ?_) j
      all_goals simp [shearToState, Matrix.vecMulVec_apply, Pi.single_apply, Matrix.single_apply, eq_comm]
    · convert hBlock (Pi.single a 1) (Pi.single b 1) using 1
      ext i j
      refine Fin.cases ?_ (fun a => ?_) i <;> refine Fin.cases ?_ (fun b => ?_) j
      all_goals simp [block, scalarBlock, RingHom.coe_mk, Matrix.vecMulVec_apply, Pi.single_apply,
        Matrix.single_apply, mul_ite, ← ite_and, eq_comm, and_comm]
  apply top_unique
  intro M _
  change M ∈ W
  rw [Matrix.matrix_eq_sum_single M]
  apply W.sum_mem
  intro i _
  apply W.sum_mem
  intro j _
  simpa [Matrix.smul_single] using W.smul_mem (M i j) (hSingle i j)

end ContinuousBilinear.FeedbackData
